{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/scripts/format-code.sh\""
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/scripts/validate-shell.sh\"",
        "matcher": "rm|curl|wget"
      }
    ],
    "sessionEnd": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/scripts/audit.sh\""
      }
    ]
  }
}
